# Normalize line endings: store text as LF in the repo.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Treat these as binary (no EOL munging / diffs).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.blend binary
