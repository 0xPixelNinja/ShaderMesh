# Root Compose environment. Copy to .env and replace placeholders.
# Never commit the resulting file. It is gitignored.

# --- Postgres ---
POSTGRES_USER=shadermesh
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=shadermesh

# --- Local demo ---
DEMO_LEASE_MANIFEST=ipfs://bafybeigdyrzt5sfp7udm7hu76uh7y26nf3ayu5ol5qi2ngv3a6h4q
# Optional. A browser wallet address to fund with test ETH and SMESH each time the
# local chain is reset, so a demo can start immediately. Local devnet only; this is
# a public address, never a key.
DEMO_FUND_ADDRESS=

# --- Interactive GPU leases ---
# A leased container publishes SSH so the requester can use the hardware. This
# relaxes the execution sandbox (network, writable root, privileged entrypoint),
# so disable it for providers that should only run non-interactive workloads.
LEASE_WORKLOAD_INTERACTIVE=true
LEASE_GPU_ENABLED=true
LEASE_WORKLOAD_GPU=true
# Per-lease SSH passwords are derived from this secret and the lease id. Replace it
# per deployment; anyone holding it can derive every lease credential.
LEASE_SSH_SECRET=replace-with-a-long-random-secret
# Address requesters connect to. Leave as localhost and the orchestrator answers
# with whichever host the requester used to reach it; set it explicitly to a public
# IP or DNS name for a provider serving remote requesters.
LEASE_SSH_HOST=localhost

# --- Sepolia operator stack ---
SEPOLIA_RPC_URL=https://sepolia.example.invalid/v3/PROJECT_ID
# This URL is embedded in browser JavaScript and must contain no secret.
PUBLIC_SEPOLIA_RPC_URL=https://public-sepolia.example.invalid
SEPOLIA_DEPLOYMENT_FILE=./contracts/deployments/sepolia.json
PROVIDER_HOST_ALLOWLIST=provider-one.example.invalid,provider-two.example.invalid

ORCHESTRATOR_PUBLIC_URL=https://api.example.invalid
ORCHESTRATOR_BIND=0.0.0.0
ORCHESTRATOR_PORT=4000
WEB_BIND=0.0.0.0
WEB_PORT=3000
IPFS_API_BIND=127.0.0.1
IPFS_API_PORT=5001
IPFS_GATEWAY_BIND=0.0.0.0
IPFS_GATEWAY_PORT=8080
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_INFERENCE_AUTH_TTL_SECONDS=120
NEXT_PUBLIC_DEFAULT_INFERENCE_CREDIT_SMESH=10
NEXT_PUBLIC_DEFAULT_LEASE_MANIFEST=ipfs://QmSVD528SpLDjcD5eEUpHuYx3BSmNJkC3MTs7hAMBMFiVd
INDEXER_BLOCK_RANGE=10
