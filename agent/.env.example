# Windows laptop provider config. Copy to .env and replace placeholders.
# Never commit the resulting file or a real private key/RPC credential.
RPC_URL=https://sepolia.example.invalid/v3/PROJECT_ID
IPFS_API_URL=https://ipfs-api.example.invalid
DEPLOYMENTS_FILE=/app/deployments/sepolia.json

# Set through the environment or an untracked .env file. Never commit the value.
PROVIDER_PRIVATE_KEY=

# Free-form hardware advertisement recorded on-chain.
CAPABILITIES={"gpu":"NVIDIA GPU MODEL","vram":"24GB","cpu":"CPU DESCRIPTION"}
RENTAL_SPEC={"gpu":"NVIDIA GPU MODEL","vram":24,"region":"region-code","models":["model-name"],"endpoint":"https://provider.example.invalid"}
RENTAL_PRICE_USD=0.42
RENTAL_INTERVAL_SECS=600
RENTAL_MIN=1
RENTAL_MAX=168
STAKE_AMOUNT_USD=100
AUTO_FAUCET=true
POLL_SECS=30

# Verifiable-task worker. Local execution is intended for tests only.
STORAGE_BACKEND=ipfs
STORAGE_ROOT=./data
EXECUTOR_BACKEND=docker
JOB_IMAGE=shadermesh/job-deterministic
JOB_MEMORY_LIMIT=512m
JOB_CPU_COUNT=1
JOB_PIDS_LIMIT=128
JOB_CONTAINER_USER=65532:65532
JOB_TMPFS_SIZE=64m
# Trusted image used only to populate each task's temporary named volume.
JOB_HELPER_IMAGE=shadermesh/agent
STAKE_AMOUNT=100000000000000000000
POLL_INTERVAL=5

# Re-execute a stable random sample of submitted tasks from other providers.
CHALLENGER=false
CHALLENGER_SAMPLE_RATE=0.1

# Bounded exponential retry for transient RPC and IPFS failures.
RETRY_MAX_ATTEMPTS=4
RETRY_INITIAL_DELAY_SECS=0.5
RETRY_MAX_DELAY_SECS=4
RETRY_BACKOFF_MULTIPLIER=2

# Managed inference endpoint. Use ollama only when OLLAMA_URL is reachable.
INFERENCE_PORT=8100
INFERENCE_BACKEND=echo
MODELS=model-name
# At the demo peg, 1 SMESH equals 1 USD. This is the price per 1,000 tokens.
INFERENCE_PRICE_SMESH_PER_1K_TOKENS=0.002
OLLAMA_URL=http://host.docker.internal:11434

# Only this exact content-addressed manifest can be accepted and served.
# With no value, the provider rejects every pending request.
LEASE_ALLOWED_MANIFEST=ipfs://QmSVD528SpLDjcD5eEUpHuYx3BSmNJkC3MTs7hAMBMFiVd

# Optional provider-approved lease workload. Omit the image to disable this runtime.
# Production images must use name@sha256:<64 hex characters>. Mutable images are
# accepted only when LEASE_ALLOW_MUTABLE_IMAGE=true for a local development build.
LEASE_WORKLOAD_IMAGE=nvidia/cuda@sha256:c87e78933f4c16e3272123bf2f75537306596d0fbaa395a29696a22786e5ee0e
LEASE_WORKLOAD_COMMAND=["bash","-lc","nvidia-smi --query-gpu=name,memory.total --format=csv,noheader && sleep 86400"]
LEASE_WORKLOAD_ENV={}
LEASE_ALLOW_MUTABLE_IMAGE=false
LEASE_MEMORY_LIMIT=4g
LEASE_CPU_COUNT=1
LEASE_PIDS_LIMIT=256
LEASE_CONTAINER_USER=65532:65532
LEASE_TMPFS_SIZE=64m

# NVIDIA Container Toolkit must be installed before enabling GPU access.
LEASE_WORKLOAD_GPU=true
LEASE_GPU_ENABLED=true
LEASE_GPU_DEVICE_IDS=0
