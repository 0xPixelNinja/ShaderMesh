# Orchestrator config. Copy to .env and adjust.
RPC_URL=http://chain:8545
IPFS_API_URL=http://ipfs:5001
# Required. Projection snapshots, cursors, and inference replay keys are stored here.
DATABASE_URL=postgres://shadermesh:shadermesh@postgres:5432/shadermesh
DEPLOYMENTS_FILE=/app/deployments/docker.json
PORT=4000
# Comma-separated exact hostnames accepted from provider endpoints on chain.
PROVIDER_HOST_ALLOWLIST=provider
PROVIDER_FETCH_TIMEOUT_MS=30000
REQUEST_BODY_LIMIT_BYTES=1048576
# Maximum eth_getLogs range. Alchemy free-tier Sepolia requires 10.
INDEXER_BLOCK_RANGE=2000
# One block-number request is made per poll. Log queries run only for new blocks.
INDEXER_POLL_INTERVAL_MS=4000
# Transient RPC failures use bounded exponential backoff.
INDEXER_RPC_RETRY_ATTEMPTS=3
INDEXER_RPC_RETRY_INTERVAL_MS=1000
# Tests only. Leave unset to skip the Postgres integration test.
# TEST_DATABASE_URL=postgres://shadermesh:shadermesh@localhost:5432/shadermesh_test
