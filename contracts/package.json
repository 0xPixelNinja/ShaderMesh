{
  "name": "shadermesh-contracts",
  "version": "0.1.0",
  "description": "ShaderMesh smart contracts: token, provider registry, job marketplace, verification game.",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "typecheck": "tsc --noEmit",
    "gas": "hardhat run scripts/gas-report.ts",
    "verify:sepolia": "hardhat run scripts/verify.ts --network sepolia",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "bootstrap:local": "hardhat run scripts/bootstrap.ts --network localhost",
    "bootstrap:sepolia": "hardhat run scripts/bootstrap.ts --network sepolia",
    "configure:sepolia-demo": "hardhat run scripts/configure-demo.ts --network sepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^22.7.4",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2"
  }
}
