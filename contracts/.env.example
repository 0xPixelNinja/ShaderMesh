# Copy to .env and replace placeholders. Never commit the resulting file.
# Use a dedicated Sepolia operator wallet with test ETH only.
SEPOLIA_RPC_URL=https://sepolia.example.invalid/v3/PROJECT_ID
PRIVATE_KEY=
ETHERSCAN_API_KEY=

# The deploy script writes this ignored file. The bootstrap script reads it.
DEPLOYMENTS_FILE=deployments/sepolia.json

# Run providers once before bootstrap so each address can self-register.
# fundSmesh is an optional minimum wallet balance, not an amount added per run.
# Keep integer-like values quoted when they may exceed JavaScript's safe range.
BOOTSTRAP_PROVIDERS_JSON=[]
# Example shape, with placeholders only:
# BOOTSTRAP_PROVIDERS_JSON=[{"address":"0x0000000000000000000000000000000000000000","gpuModel":"NVIDIA GPU MODEL","vramGB":24,"benchmarkScore":"1000","fundSmesh":"100"}]

# Set to null to skip requester funding. fundSmesh is the target wallet balance.
BOOTSTRAP_REQUESTER_JSON=null
# BOOTSTRAP_REQUESTER_JSON={"address":"0x0000000000000000000000000000000000000000","fundSmesh":"1000"}

# Short public-testnet windows for a live demonstration.
DEMO_RENTAL_GRACE_SECS=30
DEMO_CHALLENGE_WINDOW_SECS=120
DEMO_CLAIM_TIMEOUT_SECS=300
DEMO_VOTE_WINDOW_SECS=120
