NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_ORCHESTRATOR_URL=http://127.0.0.1:4000
NEXT_PUBLIC_DEPLOYMENTS_URL=/deployments/docker.json
NEXT_PUBLIC_INFERENCE_AUTH_TTL_SECONDS=120
NEXT_PUBLIC_DEFAULT_INFERENCE_CREDIT_SMESH=10
