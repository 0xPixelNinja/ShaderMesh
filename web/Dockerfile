# ShaderMesh dashboard (Next.js).
FROM node:20-bookworm-slim

WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

COPY package*.json ./
RUN npm ci

COPY . .
# NEXT_PUBLIC_* values are baked into browser JavaScript and must be public-safe.
ARG NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:4000
ARG NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
ARG NEXT_PUBLIC_CHAIN_ID=31337
ARG NEXT_PUBLIC_INFERENCE_AUTH_TTL_SECONDS=120
ARG NEXT_PUBLIC_DEFAULT_INFERENCE_CREDIT_SMESH=10
ARG NEXT_PUBLIC_DEFAULT_LEASE_MANIFEST=""
ENV NEXT_PUBLIC_ORCHESTRATOR_URL=$NEXT_PUBLIC_ORCHESTRATOR_URL
ENV NEXT_PUBLIC_RPC_URL=$NEXT_PUBLIC_RPC_URL
ENV NEXT_PUBLIC_CHAIN_ID=$NEXT_PUBLIC_CHAIN_ID
ENV NEXT_PUBLIC_INFERENCE_AUTH_TTL_SECONDS=$NEXT_PUBLIC_INFERENCE_AUTH_TTL_SECONDS
ENV NEXT_PUBLIC_DEFAULT_INFERENCE_CREDIT_SMESH=$NEXT_PUBLIC_DEFAULT_INFERENCE_CREDIT_SMESH
ENV NEXT_PUBLIC_DEFAULT_LEASE_MANIFEST=$NEXT_PUBLIC_DEFAULT_LEASE_MANIFEST
RUN npm run build

ENV NODE_ENV=production
EXPOSE 3000
CMD ["npm", "start"]
